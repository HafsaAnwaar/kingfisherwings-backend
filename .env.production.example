# Render / production env template (copy into Render Environment UI — do not commit secrets)

NODE_ENV=production
PORT=3000
PUBLIC_API_URL=https://kingfisherwings.onrender.com
APP_NAME=KingFisher Wings ERP
APP_URL=https://kingfisherwings.onrender.com
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com

# Swagger UI at /docs (set false to hide on production)
SWAGGER_ENABLED=true

# Pooled URL for runtime (app queries). Must include -pooler on Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct URL for prisma migrate deploy only (no -pooler). Required on Render if auto-strip fails.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Render deploy (recommended):
#   Pre-Deploy Command: /bin/sh /app/docker/render-predeploy.sh
# Entrypoint skips migrate on Render unless RUN_MIGRATIONS_ON_START=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=20000

REDIS_ENABLED=true
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MIN_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_64_CHARS_MIN_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=kingfisher-wings-erp
JWT_AUDIENCE=kingfisher-wings-client

PORTAL_JWT_ACCESS_SECRET=CHANGE_ME_PORTAL_ACCESS_64_CHARS_MIN
PORTAL_JWT_REFRESH_SECRET=CHANGE_ME_PORTAL_REFRESH_64_CHARS_MIN
VENDOR_JWT_ACCESS_SECRET=CHANGE_ME_VENDOR_ACCESS_64_CHARS_MIN
VENDOR_JWT_REFRESH_SECRET=CHANGE_ME_VENDOR_REFRESH_64_CHARS_MIN

# Enforce distinct portal/vendor secrets at boot (required on production)
JWT_SECRETS_STRICT=true

CRON_SECRET=CHANGE_ME_LONG_RANDOM

# Two-factor auth (disabled until product enables it)
ADMIN_2FA_REQUIRED=false

# Sentry (Week 24)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe platform billing (Week 26)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# EDI live submit (Week 26)
EDI_SUBMIT_ENABLED=false
MPCI_EDI_ENDPOINT=

# PDF — Dockerfile already sets these; keep for clarity
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_TIMEOUT=60000

STORAGE_PATH=/app/storage/uploads
STORAGE_PUBLIC_BASE_URL=/files
STORAGE_USE_S3=false
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=KingFisher Wings
SMTP_FROM_EMAIL=noreply@yourdomain.com
