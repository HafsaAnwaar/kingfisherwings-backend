  @@map("quotation_status_history")
}

model QuotationApproval {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id    String         @db.Uuid
  quotation_id String         @db.Uuid
  level        Int
  approver_id  String?        @db.Uuid
