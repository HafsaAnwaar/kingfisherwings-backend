  @@index([tenant_id, quotation_id])
  @@map("quotation_approvals")
}

// =====================================================
// ONLINE TARIFF MASTER — rate cards used to auto-populate quotation
// charge lines (sale rate + cost rate per lane/service/container type).
// customer_id NULL = applies to all customers; a specific customer_id
// overrides the general rate for that lane when both exist.
// =====================================================

model Tariff {
  id                String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id         String  @db.Uuid
  service_type      JobType
  origin_port_id    String? @db.Uuid
  dest_port_id      String? @db.Uuid
  container_type_id String? @db.Uuid
  charge_code_id    String  @db.Uuid
  customer_id       String? @db.Uuid

  unit          String? @db.VarChar(50)
  sale_rate     Decimal @db.Decimal(18, 4)
  cost_rate     Decimal @db.Decimal(18, 4)
  currency_code String  @db.Char(3)

  valid_from DateTime  @db.Date
  valid_to   DateTime? @db.Date
  is_active  Boolean   @default(true)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, service_type])
  @@index([tenant_id, origin_port_id, dest_port_id])
  @@index([tenant_id, customer_id])
  @@map("tariffs")
}

// =====================================================
// ZIP DISTANCE MASTER — location-to-location distances, used for
