// ─── PARTIES ─────────────────────────────────────────────────

model Party {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id      String    @db.Uuid
  company_id     String?   @db.Uuid
  party_type     PartyType
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(300)
  short_name     String?   @db.VarChar(100)
  vat_number     String?   @db.VarChar(50)
  cr_number      String?   @db.VarChar(50)
  country_code   String?   @db.Char(2)
  city           String?   @db.VarChar(100)
  address        String?   @db.Text
  phone          String?   @db.VarChar(30)
  email          String?   @db.VarChar(255)
  credit_limit   Decimal?  @db.Decimal(18, 2)
  credit_days    Int?
  currency_code  String?   @db.Char(3)
  salesperson_id String?   @db.Uuid
  is_active      Boolean   @default(true)
  notes          String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  created_by     String?   @db.Uuid
  updated_by     String?   @db.Uuid
  deleted_at     DateTime? @db.Timestamptz

  // Added — spec Ch.4.2 calls for these explicitly; not present in the
  // originally scaffolded model.
  credit_status          PartyCreditStatus @default(ACTIVE)
  portal_access          Boolean           @default(false)
  marketing_subscription Boolean           @default(true)
  iata_code              String?           @db.VarChar(10)
  scac_code              String?           @db.VarChar(10)
  tags                   String[]          @db.Text

  company   Company?       @relation(fields: [company_id], references: [id])
  contacts  PartyContact[]
  addresses PartyAddress[]
  invoices         Invoice[]
  payment_requests PaymentRequest[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([tenant_id, party_type])
  @@index([tenant_id, credit_status])
  @@index([tenant_id, company_id])
  @@map("parties")
}

enum PartyCreditStatus {
  ACTIVE
  ON_HOLD
  BLACKLISTED
}

