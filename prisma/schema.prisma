// ─── WEEK 17 WMS (Ch.22) ─────────────────────────────────────

enum WmsValuationMethod {
  FIFO
  LIFO
}

enum WmsDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum WmsAsnStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum WmsMovementType {
  GRN_IN
  GDO_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum WmsStorageChargeStatus {
  OPEN
  INVOICED
  WAIVED
}

model WmsSettings {
