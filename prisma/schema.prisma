  commodity         String?   @db.VarChar(500)
  hs_code           String?   @db.VarChar(12)
  gross_weight      Decimal?  @db.Decimal(12, 3)
  chargeable_weight Decimal?  @db.Decimal(12, 3)
  volume_cbm        Decimal?  @db.Decimal(10, 3)
  pieces            Int?
  container_type_id String?   @db.Uuid
  container_count   Int?
  incoterms         String?   @db.VarChar(10)
  is_dg             Boolean   @default(false)
  dg_class          String?   @db.VarChar(20)
  notes             String?   @db.Text
  customer_remarks  String?   @db.Text
  tags              String[]  @db.Text
  etd               DateTime? @db.Date
  eta               DateTime? @db.Date

