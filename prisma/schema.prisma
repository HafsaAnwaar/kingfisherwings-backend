  phone                 String?      @db.VarChar(30)
  potential_volume      String?      @db.VarChar(200)
  service_requirements  String?      @db.Text
  source                LeadSource   @default(OTHER)
  status                LeadStatus   @default(NEW)
  assigned_salesperson_id String?    @db.Uuid
  priority              LeadPriority @default(MEDIUM)
  tags                  String[]     @db.Text
  converted_party_id    String?      @db.Uuid
  lost_reason           String?      @db.VarChar(300)
  notes                 String?      @db.Text
  created_at            DateTime     @default(now()) @db.Timestamptz
