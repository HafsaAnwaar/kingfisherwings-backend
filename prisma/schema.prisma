  job_id          String?                  @db.Uuid
  document_type   DocumentType?
  pdf_mode        QuotationPdfMode?
  layout_variant  String?                  @db.VarChar(50)
  status          DocumentGenerationStatus @default(PENDING)
  bull_job_id     String?                  @db.VarChar(100)
  file_url        String?                  @db.Text
  s3_key          String?                  @db.Text
  file_name       String?                  @db.VarChar(300)
  file_size       Int?
  error_message   String?                  @db.Text
  requested_by    String?                  @db.Uuid
  started_at      DateTime?                @db.Timestamptz
  completed_at    DateTime?                @db.Timestamptz
  created_at      DateTime                 @default(now()) @db.Timestamptz
  updated_at      DateTime                 @updatedAt @db.Timestamptz

  quotation    Quotation?    @relation("QuotationDocumentTasks", fields: [quotation_id], references: [id])
  job          Job?          @relation("JobDocumentTasks", fields: [job_id], references: [id])
  job_document JobDocument[]

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, entity_type])
  @@index([bull_job_id])
  @@map("document_generation_tasks")
}

// =====================================================
// INVOICING (Ch.18) — customer/purchase invoices, credit notes, payment requests
// =====================================================

model Invoice {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id            String        @db.Uuid
  company_id           String?       @db.Uuid
  invoice_number       String        @db.VarChar(40)
  invoice_type         InvoiceType   @default(CUSTOMER_INVOICE)
  status               InvoiceStatus @default(DRAFT)
  job_id               String?       @db.Uuid
  party_id             String        @db.Uuid
  branch_id            String?       @db.Uuid
  department_id        String?       @db.Uuid
  credited_invoice_id  String?       @db.Uuid
  invoice_date         DateTime      @default(now()) @db.Date
  due_date             DateTime?     @db.Date
  currency_code        String        @db.Char(3)
  exchange_rate        Decimal       @default(1) @db.Decimal(20, 8)
  subtotal             Decimal       @default(0) @db.Decimal(18, 4)
  tax_amount           Decimal       @default(0) @db.Decimal(18, 4)
  total_amount         Decimal       @default(0) @db.Decimal(18, 4)
  amount_paid          Decimal       @default(0) @db.Decimal(18, 4)
  balance_due          Decimal       @default(0) @db.Decimal(18, 4)
  vat_rate             Decimal       @default(5) @db.Decimal(6, 3)
  party_vat_number     String?       @db.VarChar(50)
  lpo_number           String?       @db.VarChar(100)
  remarks              String?       @db.Text
  internal_notes       String?       @db.Text
  pdf_url              String?       @db.Text
  pdf_s3_key           String?       @db.Text
  pdf_generated_at     DateTime?     @db.Timestamptz
  posted_at            DateTime?     @db.Timestamptz
  sent_at              DateTime?     @db.Timestamptz
  last_emailed_at      DateTime?     @db.Timestamptz
  last_emailed_to      String?       @db.VarChar(255)
  created_at           DateTime      @default(now()) @db.Timestamptz
  updated_at           DateTime      @updatedAt @db.Timestamptz
  created_by           String?       @db.Uuid
  updated_by           String?       @db.Uuid
  deleted_at           DateTime?     @db.Timestamptz

  company          Company?  @relation(fields: [company_id], references: [id])
  job              Job?      @relation(fields: [job_id], references: [id])
  party            Party     @relation(fields: [party_id], references: [id])
  credited_invoice Invoice?  @relation("InvoiceCreditNotes", fields: [credited_invoice_id], references: [id])
  credit_notes     Invoice[] @relation("InvoiceCreditNotes")
  lines            InvoiceLine[]
  payment_requests PaymentRequest[]

  @@unique([tenant_id, invoice_number])
  @@index([tenant_id])
  @@index([tenant_id, invoice_type])
  @@index([tenant_id, status])
  @@index([tenant_id, party_id])
  @@index([tenant_id, job_id])
  @@index([tenant_id, invoice_date])
  @@index([tenant_id, due_date])
  @@map("invoices")
}

model InvoiceLine {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id            String    @db.Uuid
  invoice_id           String    @db.Uuid
  job_id               String?   @db.Uuid
  job_charge_id        String?   @unique @db.Uuid
  charge_code_id       String?   @db.Uuid
  description          String    @db.VarChar(300)
  quantity             Decimal   @default(1) @db.Decimal(10, 3)
  unit_price           Decimal   @db.Decimal(18, 4)
  amount               Decimal   @db.Decimal(18, 4)
  tax_rate_id          String?   @db.Uuid
  tax_rate             Decimal   @default(0) @db.Decimal(6, 3)
  tax_amount           Decimal   @default(0) @db.Decimal(18, 4)
  is_taxable           Boolean   @default(true)
  sort_order           Int       @default(0)
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz
  created_by           String?   @db.Uuid
  updated_by           String?   @db.Uuid
  deleted_at           DateTime? @db.Timestamptz

  invoice    Invoice     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  job_charge JobCharge?  @relation(fields: [job_charge_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([tenant_id, invoice_id])
  @@index([tenant_id, job_id])
  @@map("invoice_lines")
}

model PaymentRequest {
  id              String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id       String               @db.Uuid
  request_number  String               @db.VarChar(40)
  status          PaymentRequestStatus @default(PENDING)
  invoice_id      String?              @db.Uuid
  job_id          String?              @db.Uuid
  party_id        String               @db.Uuid
  amount          Decimal              @db.Decimal(18, 4)
  currency_code   String               @db.Char(3)
  due_date        DateTime?            @db.Date
  remarks         String?              @db.Text
  approved_at     DateTime?            @db.Timestamptz
  approved_by     String?              @db.Uuid
  rejected_reason String?              @db.VarChar(500)
  paid_at         DateTime?            @db.Timestamptz
  created_at      DateTime             @default(now()) @db.Timestamptz
  updated_at      DateTime             @updatedAt @db.Timestamptz
  created_by      String?              @db.Uuid
  updated_by      String?              @db.Uuid
  deleted_at      DateTime?            @db.Timestamptz

  invoice Invoice? @relation(fields: [invoice_id], references: [id])
  job     Job?     @relation(fields: [job_id], references: [id])
  party   Party    @relation(fields: [party_id], references: [id])

  @@unique([tenant_id, request_number])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, party_id])
  @@index([tenant_id, invoice_id])
  @@index([tenant_id, job_id])
  @@map("payment_requests")
}

// =====================================================
// SUPER ADMIN — platform owner, NOT tenant-scoped.
// Deliberately separate from User: creates/manages Tenants and is
// never subject to Row-Level Security or tenant_id filtering.
// =====================================================

model SuperAdmin {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  email         String @unique @db.VarChar(255)
  password_hash String @db.Text

  first_name String @db.VarChar(100)
  last_name  String @db.VarChar(100)

  is_active          Boolean   @default(true)
  failed_login_count Int       @default(0)
  locked_until       DateTime? @db.Timestamptz
  last_login_at      DateTime? @db.Timestamptz
  last_login_ip      String?   @db.VarChar(45)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  sessions SuperAdminSession[]

  tenants_created Tenant[] @relation("TenantCreatedBySuperAdmin")
  users_created   User[]   @relation("UserCreatedBySuperAdmin")

  @@map("super_admins")
}

model SuperAdminSession {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  super_admin_id String @db.Uuid
  jti            String @unique @db.VarChar(200)

  refresh_token_hash String  @db.Text
  ip_address         String? @db.VarChar(45)
  user_agent         String? @db.Text

  is_active      Boolean   @default(true)
  expires_at     DateTime  @db.Timestamptz
  last_used_at   DateTime  @default(now()) @db.Timestamptz
  revoked_at     DateTime? @db.Timestamptz
  revoked_reason String?   @db.VarChar(100)

  created_at DateTime @default(now()) @db.Timestamptz

  super_admin SuperAdmin @relation(fields: [super_admin_id], references: [id], onDelete: Cascade)

  @@index([super_admin_id])
  @@index([jti])
  @@map("super_admin_sessions")
}

enum SingleDevicePolicy {
  TERMINATE_OLDEST
  REJECT_NEW
}
