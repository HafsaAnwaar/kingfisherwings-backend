// ─── JOBS ────────────────────────────────────────────────────

model Job {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id     String    @db.Uuid
  company_id    String?   @db.Uuid
  job_number    String    @db.VarChar(30)
  /// Public tracking token (unguessable) for GET /track — not the sequential job number alone.
  tracking_token String   @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-', '')")) @db.VarChar(64)
  job_type      JobType
  status        JobStatus @default(ENQUIRY)
  branch_id     String?   @db.Uuid
  department_id String?   @db.Uuid

  /// House job if set (points at the Master); NULL means this job IS a master (or a standalone job with no consolidation).
  parent_job_id         String? @db.Uuid
  /// True when created via POST /jobs/:id/sub-jobs (operational sub-file under a parent).
  is_sub_job            Boolean @default(false)
  /// Set when this job originated from a won Quotation — the reverse of Quotation.converted_job_id.
  created_from_quote_id String? @db.Uuid

  /// Scheduled pre-alert (Week 6) — cron sends when scheduled_at <= now.
  pre_alert_scheduled_at DateTime? @db.Timestamptz
  pre_alert_to_email     String?   @db.VarChar(255)
  pre_alert_message      String?   @db.Text
  pre_alert_sent_at      DateTime? @db.Timestamptz

  shipper_id        String?   @db.Uuid
  consignee_id      String?   @db.Uuid
  /// Bill-to / paying customer — optional third ownership key for portal visibility.
  billing_party_id  String?   @db.Uuid
  agent_id          String?   @db.Uuid
  salesperson_id    String?   @db.Uuid
  ops_user_id       String?   @db.Uuid
