  @@index([tenant_id])
  @@index([tenant_id, job_id])
  @@map("job_notes")
}

// =====================================================
// SUPER ADMIN — platform owner, NOT tenant-scoped.
// Deliberately separate from User: creates/manages Tenants and is
// never subject to Row-Level Security or tenant_id filtering.
// =====================================================

model SuperAdmin {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  email         String @unique @db.VarChar(255)
  password_hash String @db.Text

  first_name String @db.VarChar(100)
  last_name  String @db.VarChar(100)

  is_active          Boolean   @default(true)
  failed_login_count Int       @default(0)
  locked_until       DateTime? @db.Timestamptz
  last_login_at      DateTime? @db.Timestamptz
  last_login_ip      String?   @db.VarChar(45)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  sessions SuperAdminSession[]

  tenants_created Tenant[] @relation("TenantCreatedBySuperAdmin")
  users_created   User[]   @relation("UserCreatedBySuperAdmin")

  @@map("super_admins")
}

model SuperAdminSession {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  super_admin_id String @db.Uuid
  jti            String @unique @db.VarChar(200)

  refresh_token_hash String  @db.Text
  ip_address         String? @db.VarChar(45)
  user_agent         String? @db.Text

  is_active      Boolean   @default(true)
  expires_at     DateTime  @db.Timestamptz
  last_used_at   DateTime  @default(now()) @db.Timestamptz
  revoked_at     DateTime? @db.Timestamptz
  revoked_reason String?   @db.VarChar(100)

  created_at DateTime @default(now()) @db.Timestamptz

  super_admin SuperAdmin @relation(fields: [super_admin_id], references: [id], onDelete: Cascade)

  @@index([super_admin_id])
  @@index([jti])
  @@map("super_admin_sessions")
}

enum SingleDevicePolicy {
  TERMINATE_OLDEST
  REJECT_NEW
}
