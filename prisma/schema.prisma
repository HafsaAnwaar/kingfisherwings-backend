/// In-app notifications for staff users and/or portal users.
model Notification {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id      String           @db.Uuid
  /// Staff ERP user. Null when notification is for a portal/vendor user.
  user_id        String?          @db.Uuid
  /// Portal user. Null when notification is for staff or vendor.
  portal_user_id String?          @db.Uuid
  vendor_user_id String?          @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  message        String           @db.Text
  entity_type    String?          @db.VarChar(50)
  entity_id      String?          @db.Uuid
  link_path      String?          @db.VarChar(500)
  is_read        Boolean          @default(false)
  read_at        DateTime?        @db.Timestamptz
  created_at     DateTime         @default(now()) @db.Timestamptz

  user        User?       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  portal_user PortalUser? @relation(fields: [portal_user_id], references: [id], onDelete: Cascade)
  vendor_user VendorUser? @relation(fields: [vendor_user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, user_id, is_read, created_at])
  @@index([tenant_id, portal_user_id, is_read, created_at])
  @@index([tenant_id, vendor_user_id, is_read, created_at])
  @@index([tenant_id, type])
  @@map("notifications")
}

