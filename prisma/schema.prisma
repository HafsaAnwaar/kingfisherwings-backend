  @@index([tenant_id])
  @@index([tenant_id, job_type])
  @@index([tenant_id, status])
  @@index([tenant_id, etd])
  @@index([tenant_id, created_at(sort: Desc)])
  @@index([tenant_id, parent_job_id])
  @@index([tenant_id, company_id])
  @@map("jobs")
}

