// ───────────────────────────────────────────────────────────────
// TENANTS
// ───────────────────────────────────────────────────────────────

model Tenant {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Identity
  code         String  @unique @db.VarChar(20)
  name         String  @db.VarChar(200)
  display_name String? @db.VarChar(200)
  slug         String  @unique @db.VarChar(100)

  // Branding
  domain        String? @unique @db.VarChar(200)
  website       String? @db.VarChar(255)
  logo_url      String? @db.Text
  primary_color String? @db.VarChar(20)

  // Localization
  language             String  @default("en") @db.VarChar(10)
  base_currency        String  @default("USD") @db.Char(3)
  timezone             String  @default("Asia/Dubai") @db.VarChar(100)
  /// Optional — set/changed any time after signup (SuperAdmin or tenant admin). When null, phones use international E.164 and currency/timezone keep their own defaults.
  country_code         String? @db.Char(2)
  financial_year_start Int     @default(1)

  // Business Registration
  vat_number String? @db.VarChar(50)
  cr_number  String? @db.VarChar(50)

  // Added — spec Ch.4.1: cargo agent identity, needed on shipping documents.
  iata_cargo_agent_code String? @db.VarChar(20)
  customs_code          String? @db.VarChar(50)
  customs_license_no    String? @db.VarChar(50)

  // Contact
  address String? @db.Text
  city    String? @db.VarChar(100)
  phone   String? @db.VarChar(30)
  email   String? @db.VarChar(255)

  // Security — the tenant's own login credential (see SuperAdmin-created
  // tenants: this is what the tenant owner logs in with at POST /auth/tenant-login)
  password_hash String @db.Text

  // Subscription
  subscription_plan SubscriptionPlan @default(TRIAL)
  status            TenantStatus     @default(TRIAL)
  trial_ends        DateTime?
  subscription_ends DateTime?

  // Limits
  max_users      Int @default(10)
  max_branches   Int @default(1)
  max_storage_gb Int @default(5)

  // Status
  is_active Boolean @default(true)

  // Audit
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  created_by_super_admin_id String? @db.Uuid

  // Relationships
  created_by_super_admin SuperAdmin? @relation("TenantCreatedBySuperAdmin", fields: [created_by_super_admin_id], references: [id])

  users            User[]              @relation("TenantUsers")
  users_created    User[]              @relation("UserCreatedByTenant")
  branches         Branch[]
  roles            Role[]
  password_history PasswordHistory[]
  login_history    LoginHistory[]
  bank_accounts    TenantBankAccount[]
  companies        Company[]
  portal_users     PortalUser[]
  vendor_users     VendorUser[]

  @@index([created_by_super_admin_id])
  @@map("tenants")
}

// =====================================================
// COMPANY — a legal entity operating under a Tenant's SaaS
// subscription. Most tenants have exactly one (created automatically
// alongside the tenant, is_default=true); a holding-group tenant can
// register more via POST /companies for multi-company consolidation
// (spec's "Group P&L / Multi-Company" reports). Branches, Departments,
// Users, Parties, and Quotations all carry company_id — see each
// model for the reasoning on why that one does or doesn't.
// =====================================================

model Company {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id String @db.Uuid

  code                String  @db.VarChar(20)
  name                String  @db.VarChar(300)
  legal_name          String? @db.VarChar(300)
  registration_number String? @db.VarChar(100)
  vat_number          String? @db.VarChar(50)

  address      String? @db.Text
  city         String? @db.VarChar(100)
  country_code String? @db.Char(2)
  phone        String? @db.VarChar(30)
  email        String? @db.VarChar(255)

  /// Every tenant has exactly one default company (set at tenant creation); additional companies are opt-in for multi-entity groups.
  is_default Boolean @default(false)
  is_active  Boolean @default(true)

  /// UAE WPS employer MOL / EDR identifier (Week 16).
  wps_employer_mol_id    String? @db.VarChar(30)
  wps_agent_routing_code String? @db.VarChar(20)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  branches     Branch[]
  departments  Department[]
  designations Designation[]
  users        User[]
  parties      Party[]
  quotations   Quotation[]
  jobs         Job[]
  invoices     Invoice[]
  chart_of_accounts ChartOfAccount[]
  vouchers     Voucher[]
  payments     Payment[]
  cheques      Cheque[]
  bank_reconciliations BankReconciliation[]
  saved_reports SavedReport[]
  hr_employees  HrEmployee[]
  hr_payroll_settings HrPayrollGlSetting[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("companies")
}

// =====================================================
// ORGANIZATION PROFILE — Batch 5
// =====================================================

model TenantBankAccount {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id      String    @db.Uuid
  bank_name      String    @db.VarChar(200)
  account_name   String    @db.VarChar(200)
  account_number String    @db.VarChar(50)
  iban           String?   @db.VarChar(50)
  swift_code     String?   @db.VarChar(20)
  currency_code  String    @default("AED") @db.Char(3)
  branch_id      String?   @db.Uuid
  /// Optional link to a Chart of Accounts bank ledger account (Ch.19)
  gl_account_id  String?   @db.Uuid
  is_default     Boolean   @default(false)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  created_by     String?   @db.Uuid
  updated_by     String?   @db.Uuid
  deleted_at     DateTime? @db.Timestamptz

  tenant      Tenant          @relation(fields: [tenant_id], references: [id])
  gl_account  ChartOfAccount? @relation("BankAccountGlLink", fields: [gl_account_id], references: [id])
  payments    Payment[]
  cheques     Cheque[]
  reconciliations BankReconciliation[]

  @@index([tenant_id])
  @@index([tenant_id, gl_account_id])
  @@map("tenant_bank_accounts")
}

enum DocumentNumberType {
  JOB_NUMBER
  QUOTATION
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  HAWB
  MAWB
  HBL
  MBL
  VOUCHER
  BOOKING
  GRN
  GDO
  ASN
  PURCHASE_INVOICE
  PAYMENT
  EMPLOYEE_CODE
  TRANSPORT_REQUEST
  NVOCC_VOYAGE
  NVOCC_ENQUIRY
  NVOCC_BOOKING
}

enum DocumentNumberResetFrequency {
  NEVER
  YEARLY
  MONTHLY
}

model DocumentNumberFormat {
  id                  String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id           String                       @db.Uuid
  document_type       DocumentNumberType
  prefix              String                       @db.VarChar(20)
  include_branch_code Boolean                      @default(false)
  include_year        Boolean                      @default(true)
  year_digits         Int                          @default(2)
  include_month       Boolean                      @default(false)
  sequence_length     Int                          @default(5)
  separator           String                       @default("/") @db.VarChar(3)
  reset_frequency     DocumentNumberResetFrequency @default(YEARLY)
  is_active           Boolean                      @default(true)
  created_at          DateTime                     @default(now()) @db.Timestamptz
  updated_at          DateTime                     @updatedAt @db.Timestamptz
  created_by          String?                      @db.Uuid
  updated_by          String?                      @db.Uuid

  @@unique([tenant_id, document_type])
  @@index([tenant_id])
  @@map("document_number_formats")
}

model DocumentNumberSequence {
  id            String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id     String             @db.Uuid
  document_type DocumentNumberType
  branch_code   String             @default("") @db.VarChar(20)
  period_key    String             @default("") @db.VarChar(20)
  last_sequence Int                @default(0)
  updated_at    DateTime           @updatedAt @db.Timestamptz

  @@unique([tenant_id, document_type, branch_code, period_key])
  @@index([tenant_id])
  @@map("document_number_sequences")
}

// ─── USERS ───────────────────────────────────────────────────

model User {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // ================================
  // Multi-Tenancy
  // ================================

  tenant_id String @db.Uuid

  // ================================
  // Identity
  // ================================

  email         String @db.VarChar(255)
  password_hash String @db.Text

  first_name String @db.VarChar(100)
  last_name  String @db.VarChar(100)

  phone String? @db.VarChar(30)

  avatar_url String? @db.Text

  locale String @default("en") @db.VarChar(10)

  /// Optional personal country preference (ISO 3166-1 alpha-2). User can set after login; used for phone/tax validation when a record has no country_code of its own.
  preferred_country_code String? @db.Char(2)

  // (Temporary, will be removed after RBAC)
  role UserRole @default(READ_ONLY)

  status UserStatus @default(INVITED)

  // ================================
  // Organization
  // ================================

  company_id    String? @db.Uuid
  branch_id     String? @db.Uuid
  department_id String? @db.Uuid

  company    Company?    @relation(fields: [company_id], references: [id])
  branch     Branch?     @relation(fields: [branch_id], references: [id])
  department Department? @relation(fields: [department_id], references: [id])

  is_salesperson Boolean @default(false)
  is_cs_rep      Boolean @default(false)
  is_operations  Boolean @default(false)
  is_finance     Boolean @default(false)

  // ================================
  // Legacy Permissions
  // (Will migrate to Permission table)
  // ================================

  can_see_sales         Boolean @default(false)
  can_see_cost          Boolean @default(false)
  can_see_gp            Boolean @default(false)
  can_see_invoices      Boolean @default(false)
  can_see_payments      Boolean @default(false)
  can_see_bank_balances Boolean @default(false)
  can_see_ar_ap         Boolean @default(false)
  can_see_mgmt_reports  Boolean @default(false)
  can_see_job_pnl       Boolean @default(false)

  // ================================
  // Login Security
  // ================================

  last_login_at DateTime? @db.Timestamptz
  last_login_ip String?   @db.VarChar(45)

  last_login_device   String? @db.VarChar(255)
  last_login_browser  String? @db.VarChar(255)
  last_login_location String? @db.VarChar(255)

  last_activity_at DateTime? @db.Timestamptz

  failed_login_count Int @default(0)

  last_failed_login_at DateTime? @db.Timestamptz

  locked_until DateTime? @db.Timestamptz

  // ================================
  // Access Restrictions
  // ================================

  allowed_ips           String[] @db.Text
  allowed_mac_addresses String[] @db.Text

  office_hours_start    String? @db.VarChar(5)
  office_hours_end      String? @db.VarChar(5)
  office_hours_timezone String? @db.VarChar(100)

  max_concurrent_sessions Int @default(3)

  // Premium Single Device Login (spec Phase 7): when enabled, a new
  // login while a session already exists either rejects the new login
  // or terminates the old one, per single_device_policy.
  single_device_login  Boolean            @default(false)
  single_device_policy SingleDevicePolicy @default(TERMINATE_OLDEST)

  // ================================
  // Two Factor Authentication
  // ================================

  two_factor_enabled      Boolean  @default(false)
  two_factor_secret       String?  @db.Text
  two_factor_backup_codes String[] @db.Text

  // ================================
  // Email Verification
  // ================================

  email_verified    Boolean   @default(false)
  email_verified_at DateTime? @db.Timestamptz

  // ================================
  // Invitation
  // ================================

  invite_token      String?   @db.VarChar(200)
  invite_expires_at DateTime? @db.Timestamptz

  // ================================
  // Password
  // ================================

  password_reset_token   String?   @db.VarChar(200)
  password_reset_expires DateTime? @db.Timestamptz

  password_changed_at DateTime? @db.Timestamptz

  password_expires_at DateTime? @db.Timestamptz

  must_change_password Boolean @default(false)

  // Temporary
  refresh_token_hash String? @db.Text

  // ================================
  // Audit
  // ================================

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  created_by_user_id        String? @db.Uuid
  created_by_tenant_id      String? @db.Uuid
  created_by_super_admin_id String? @db.Uuid

  updated_by String? @db.Uuid

  deleted_at DateTime? @db.Timestamptz

  // ================================
  // Relationships
  // ================================

  tenant Tenant @relation("TenantUsers", fields: [tenant_id], references: [id])

  created_by_user        User?       @relation("UserCreatedByUser", fields: [created_by_user_id], references: [id])
  created_by_tenant      Tenant?     @relation("UserCreatedByTenant", fields: [created_by_tenant_id], references: [id])
  created_by_super_admin SuperAdmin? @relation("UserCreatedBySuperAdmin", fields: [created_by_super_admin_id], references: [id])

  users_created User[] @relation("UserCreatedByUser")

  sessions Session[]

  permissions UserPermission[]

  roles UserRoleAssignment[]

  password_history PasswordHistory[]

  login_history LoginHistory[]

  notifications Notification[]
  assigned_leads       Lead[]              @relation("LeadAssignee")
  call_logs            CallLog[]           @relation("CallLogOwner")
  follow_ups           FollowUp[]          @relation("FollowUpOwner")
  salesperson_budgets  SalespersonBudget[]
  email_campaigns      EmailCampaign[]     @relation("CampaignCreator")
  hr_employees         HrEmployee[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, role])
  @@index([tenant_id, company_id])
  @@index([email])
  @@index([created_by_user_id])
  @@index([created_by_tenant_id])
  @@index([created_by_super_admin_id])
  @@map("users")
}

model UserRoleAssignment {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  tenant_id String @db.Uuid

  user_id String @db.Uuid

  role_id String @db.Uuid

  assigned_at DateTime @default(now()) @db.Timestamptz

  assigned_by String? @db.Uuid

  user User @relation(fields: [user_id], references: [id])

