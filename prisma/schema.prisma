  job_type      JobType
  status        JobStatus @default(ENQUIRY)
  branch_id     String?   @db.Uuid
  department_id String?   @db.Uuid

  /// House job if set (points at the Master); NULL means this job IS a master (or a standalone job with no consolidation).
  parent_job_id         String? @db.Uuid
  /// Set when this job originated from a won Quotation — the reverse of Quotation.converted_job_id.
  created_from_quote_id String? @db.Uuid

  shipper_id        String?   @db.Uuid
  consignee_id      String?   @db.Uuid
  agent_id          String?   @db.Uuid
  salesperson_id    String?   @db.Uuid
  ops_user_id       String?   @db.Uuid
