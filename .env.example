# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Fresa Gold ERP"
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
CRON_SECRET=dev-cron-secret-change-me

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/fresa_gold_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fresa:
REDIS_TTL_DEFAULT=900
REDIS_TTL_SESSION=86400
REDIS_TTL_PERMISSIONS=300
REDIS_TTL_EXCHANGE_RATES=3600
REDIS_TTL_MASTERS=86400

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_STRING_FOR_PRODUCTION_1
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_STRING_FOR_PRODUCTION_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=fresa-gold-erp
JWT_AUDIENCE=fresa-gold-client

# ── Security ──────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_AGE_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SESSION_MAX_CONCURRENT=3

# ── 2FA ───────────────────────────────────────────────────────
TWO_FACTOR_APP_NAME="Fresa Gold ERP"
TWO_FACTOR_ISSUER=FresaGold

# ── AWS S3 ────────────────────────────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=fresa-gold-documents
AWS_S3_ENDPOINT=
AWS_S3_PRESIGNED_URL_EXPIRES=3600

# ── Email ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Fresa Gold ERP"
SMTP_FROM_EMAIL=noreply@fresagold.com

# ── BullMQ ────────────────────────────────────────────────────
QUEUE_PDF_CONCURRENCY=3
QUEUE_EMAIL_CONCURRENCY=5
QUEUE_IMPORT_CONCURRENCY=2

# ── External APIs ─────────────────────────────────────────────
XE_API_ID=
XE_API_KEY=
XE_API_URL=https://xecdapi.xe.com/v1/
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# ── Puppeteer / PDF ───────────────────────────────────────────
# Docker/Render: Dockerfile sets PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Local Windows example:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
PDF_OUTPUT_PATH=/tmp/pdf

# ── Local file storage (PDFs / uploads) ───────────────────────
STORAGE_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=/files
STORAGE_USE_S3=false

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
